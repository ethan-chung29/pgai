# Copy this file to .env and fill in real values.
# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored and must never be committed.

# --- Required ---

# OpenAI: Realtime API for the patient voice, and transcript analysis.
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxx

# Twilio: places the outbound call.  https://console.twilio.com
# A TRIAL account cannot dial the assessment line. Upgrade first.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+15550000000

# Public tunnel so Twilio can reach this machine.
# Run: ngrok http 5050   then copy the host WITHOUT the https:// prefix.
# Free-tier ngrok issues a new host each restart, so update this per session.
PUBLIC_HOST=xxxxxxxx.ngrok-free.app

# --- Optional (defaults shown; safe to delete this whole block) ---

PORT=5050
REALTIME_MODEL=gpt-realtime
REALTIME_VOICE=alloy
ANALYSIS_MODEL=gpt-4o
TRANSCRIPT_DIR=transcripts
RECORDING_DIR=recordings
